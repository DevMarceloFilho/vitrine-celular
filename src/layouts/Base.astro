---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import LangSwitch from "../components/LangSwitch.astro";
import {
  copy,
  defaultColor,
  defaultLang,
  htmlLang,
  isLang,
  languages,
  layerIds,
  switchLangPath,
  type Lang,
} from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.replace(/\/+$/, "");
const siteRoot = Astro.site ?? Astro.url;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(switchLangPath(Astro.url.pathname, l, baseUrl), siteRoot).href,
}));

// Open Graph: imagem de compartilhamento = pôster da abertura (se já foi gerado).
const ogLocale: Record<Lang, string> = { pt: "pt_BR", en: "en_US" };
const canonical = new URL(Astro.url.pathname, siteRoot).href;
const introPoster = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/posters/intro.png", { eager: true }),
)[0]?.default;
const ogImage = introPoster ? new URL(introPoster.src, siteRoot).href : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]} data-color={defaultColor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060607" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href={`${assetBase}/favicon.svg`} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <canvas class="stage" data-stage aria-hidden="true"></canvas>
    <div class="labels" data-labels aria-hidden="true">
      {layerIds.map((id) => <span class="label" data-label={id}>{copy[lang].labels[id]}</span>)}
    </div>
    <header class="site-header">
      <a class="wordmark" href="#intro">Orbe</a>
      <LangSwitch lang={lang} />
    </header>
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style is:global>
  /* O canvas só aparece quando o 3D montou; sem ele, a página é só texto (e pôsteres na V7). */
  .stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
  }

  html[data-stage="ready"] .stage {
    display: block;
  }

  /* Rótulos da vista explodida: posicionados pelo 3D, decorativos (a lista de camadas está no HTML). */
  .labels {
    position: fixed;
    inset: 0;
    display: none;
    pointer-events: none;
    z-index: 2;
  }

  html[data-stage="ready"] .labels {
    display: block;
  }

  .label {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    color: var(--text);
    font-size: 0.8125rem;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-s) var(--gutter);
    z-index: 10;
  }

  .wordmark {
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
</style>
