---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import LangSwitch from "../components/LangSwitch.astro";
import {
  copy,
  defaultColor,
  defaultLang,
  htmlLang,
  isLang,
  languages,
  layerIds,
  switchLangPath,
  type Lang,
} from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang: Lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.replace(/\/+$/, "");
const siteRoot = Astro.site ?? Astro.url;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(switchLangPath(Astro.url.pathname, l, baseUrl), siteRoot).href,
}));

// Open Graph: imagem de compartilhamento = pôster da abertura (se já foi gerado).
const ogLocale: Record<Lang, string> = { pt: "pt_BR", en: "en_US" };
const canonical = new URL(Astro.url.pathname, siteRoot).href;
const introPoster = Object.values(
  import.meta.glob<{ default: ImageMetadata }>("../assets/posters/intro.png", { eager: true }),
)[0]?.default;
const ogImage = introPoster ? new URL(introPoster.src, siteRoot).href : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]} data-color={defaultColor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ebe8e3" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href={`${assetBase}/favicon.svg`} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <canvas class="stage" data-stage aria-hidden="true"></canvas>
    <div class="labels" data-labels aria-hidden="true">
      {layerIds.map((id) => <span class="label mono" data-label={id}>{copy[lang].labels[id]}</span>)}
    </div>
    <header class="site-header">
      <a class="wordmark" href="#intro">Orbe</a>
      <span class="scene-index mono" data-scene-index aria-hidden="true"></span>
      <LangSwitch lang={lang} />
    </header>
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style is:global>
  /* O canvas só aparece quando o 3D montou; sem ele, a página é só texto e pôsteres. */
  .stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
    z-index: 0;
  }

  html[data-stage="ready"] .stage {
    display: block;
  }

  /* Na abertura, o aparelho fica na frente do nome gigante (profundidade); depois, atrás do texto. */
  body[data-scene="intro"] .stage {
    z-index: 2;
  }

  /* Rótulos da vista explodida: posicionados pelo 3D, decorativos (a lista de camadas está no HTML). */
  .labels {
    position: fixed;
    inset: 0;
    display: none;
    pointer-events: none;
    z-index: 3;
  }

  html[data-stage="ready"] .labels {
    display: block;
  }

  /* No celular os rótulos flutuantes cairiam sobre o texto: lá vale a lista de camadas da cena. */
  html[data-layout="mobile"] .labels {
    display: none;
  }

  .label {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--text);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 1.25rem var(--gutter);
    z-index: 10;
    /* Cor do tema (tinta no estúdio claro, papel nas cenas escuras), com a mesma transição do fundo. */
    color: var(--text);
    transition: color 0.8s var(--ease);
  }

  .wordmark {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .scene-index {
    min-width: 12ch;
    text-align: center;
  }

  @media (max-width: 599.98px) {
    .scene-index {
      visibility: hidden;
      min-width: 0;
    }
  }

  .site-header :global(.lang-switch) {
    justify-self: end;
    color: inherit;
  }
</style>
