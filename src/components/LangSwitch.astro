---
import { htmlLang, languages, switchLangPath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const target: Lang = lang === "pt" ? "en" : "pt";
const href = switchLangPath(Astro.url.pathname, target, import.meta.env.BASE_URL);
---

<a class="lang-switch mono" href={href} hreflang={htmlLang[target]} lang={htmlLang[target]}>
  {languages[target]}
</a>

<style>
  .lang-switch {
    text-decoration: none;
  }

  .lang-switch:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
