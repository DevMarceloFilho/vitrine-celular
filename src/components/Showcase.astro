---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { colorIds, colorways, copy, defaultColor, sceneIds, type SceneId, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = copy[lang];

// Pôsteres gerados por `npm run posters`. Se ainda não existirem, as cenas ficam só com texto.
const posterFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/posters/*.png", { eager: true });
const poster = (name: string) => posterFiles[`../assets/posters/${name}.png`]?.default;
const postersFor = (id: SceneId) =>
  id === "colors"
    ? colorIds.map((color) => ({ image: poster(`colors-${color}`), color }))
    : [{ image: poster(id), color: undefined }];
const number = (i: number) => String(i + 1).padStart(2, "0");
---

<Base title={text.meta.title} description={text.meta.description}>
  <main>
    {
      sceneIds.map((id, i) => {
        const scene = text.scenes[id];
        return (
          <section
            class={`scene scene--${id}`}
            id={id}
            data-scene-id={id}
            data-scene-label={`${number(i)} / ${scene.eyebrow}`}
            aria-labelledby={`${id}-title`}
          >
            {id === "intro" ? (
              <div class="hero">
                <p class="hero-kicker mono">{text.hero.kicker}</p>
                <h1 id="intro-title" class="hero-title">
                  {scene.title}
                </h1>
                <div class="hero-foot">
                  <p class="hero-tagline">{scene.body}</p>
                  <ul class="hero-meta mono">
                    {text.hero.meta.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            ) : (
              <div class="copy">
                <p class="index mono">
                  <span>{number(i)}</span> / {scene.eyebrow}
                </p>
                <h2 id={`${id}-title`} data-reveal>
                  {scene.title}
                </h2>
                <p class="body">{scene.body}</p>

                {id === "inside" && (
                  <ol class="layers">
                    {text.layers.map((layer) => (
                      <li>{layer}</li>
                    ))}
                  </ol>
                )}

                {id === "colors" && (
                  <div class="colors" role="group" aria-label={text.colorsLabel}>
                    {colorIds.map((color) => (
                      <button
                        type="button"
                        class="color"
                        data-color-option={color}
                        aria-pressed={color === defaultColor ? "true" : "false"}
                        style={`--swatch: ${colorways[color].frame}`}
                      >
                        <span class="swatch" aria-hidden="true" />
                        {text.colors[color]}
                      </button>
                    ))}
                  </div>
                )}

                {id === "specs" && (
                  <table class="specs">
                    <caption class="mono">{text.specs.caption}</caption>
                    <tbody>
                      {text.specs.rows.map(([label, value]) => (
                        <tr>
                          <th scope="row" class="mono">
                            {label}
                          </th>
                          <td>{value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}

                {id === "end" && (
                  <ul class="links">
                    {text.links.map((link) => (
                      <li>
                        <a href={link.href} rel="noopener">
                          {link.label} <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            )}

            <div class="poster-slot">
              {postersFor(id).map(
                ({ image, color }) =>
                  image && (
                    <Picture
                      src={image}
                      formats={["avif", "webp"]}
                      widths={[450, 900]}
                      sizes="(min-width: 1024px) 26rem, 70vw"
                      alt=""
                      class="poster"
                      data-poster
                      data-poster-color={color}
                      loading={id === "intro" ? "eager" : "lazy"}
                      fetchpriority={id === "intro" ? "high" : "auto"}
                    />
                  ),
              )}
            </div>
          </section>
        );
      })
    }
  </main>
</Base>

<style>
  .scene {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: var(--space-xl) var(--gutter) var(--space-l);
  }

  @media (min-width: 1024px) {
    .scene {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
    }
  }

  /* Sem 3D, as cenas escuras ganham o próprio fundo (com 3D, quem muda é o body). */
  :global(html:not([data-stage="ready"])) .scene--camera,
  :global(html:not([data-stage="ready"])) .scene--inside {
    --bg: var(--night);
    --text: var(--paper);
    --muted: #9c9993;
    --line: rgb(242 240 235 / 0.16);
    background: var(--bg);
    color: var(--text);
  }

  /* ---- Abertura ------------------------------------------------------------------------- */
  .scene--intro {
    display: block;
    padding: 0;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 5.5rem var(--gutter) var(--space-m);
    overflow: clip;
  }

  .hero-kicker {
    color: var(--muted);
    margin: 0;
  }

  .hero-title {
    align-self: center;
    justify-self: center;
    font-size: var(--step-hero);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-foot {
    display: grid;
    gap: var(--space-s);
    align-items: end;
  }

  @media (min-width: 1024px) {
    .hero-foot {
      grid-template-columns: 1fr auto;
    }
  }

  .hero-tagline {
    font-size: var(--step-1);
    max-width: 22ch;
    margin: 0;
    line-height: 1.25;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  /* O pôster da abertura (sem 3D) fica na frente do nome, como o aparelho 3D. */
  .scene--intro .poster-slot {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .scene--intro .poster-slot :global(.poster) {
    max-width: min(24rem, 60vw);
  }

  /* ---- Cenas ------------------------------------------------------------------------------ */
  .copy {
    max-width: 32rem;
  }

  .index {
    color: var(--muted);
    margin: 0 0 var(--space-m);
  }

  .index span {
    color: var(--text);
  }

  h2 {
    font-size: var(--step-2);
  }

  .body {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.35;
    margin: var(--space-m) 0 0;
    max-width: 30ch;
  }

  .layers {
    counter-reset: layer;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .layers li {
    counter-increment: layer;
    border-top: 1px solid var(--line);
    padding: 0.7rem 0;
  }

  .layers li::before {
    content: counter(layer, decimal-leading-zero);
    display: inline-block;
    width: 3ch;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .colors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-m);
  }

  .color {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.4rem 1.1rem 0.4rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.3s var(--ease);
  }

  .color:hover {
    border-color: var(--text);
  }

  .color[aria-pressed="true"] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .swatch {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .specs {
    width: 100%;
    margin-top: var(--space-m);
    border-collapse: collapse;
  }

  .specs caption {
    color: var(--muted);
    text-align: left;
    padding-bottom: 0.75rem;
  }

  .specs th,
  .specs td {
    border-top: 1px solid var(--line);
    padding: 0.85rem 0;
    text-align: left;
    vertical-align: baseline;
  }

  .specs th {
    color: var(--muted);
    font-weight: 400;
    padding-right: var(--space-s);
    width: 42%;
  }

  .specs td {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .links {
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding: 1rem 0;
    font-size: var(--step-1);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
  }

  /* ---- Pôsteres (sem WebGL, sem JS ou com movimento reduzido) ------------------------------ */
  .poster-slot {
    display: grid;
    justify-items: center;
  }

  .poster-slot :global(.poster) {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  .poster-slot :global(.poster[data-poster-color]) {
    display: none;
  }

  :global(html[data-color="graphite"]) .poster-slot :global(.poster[data-poster-color="graphite"]),
  :global(html[data-color="sand"]) .poster-slot :global(.poster[data-poster-color="sand"]),
  :global(html[data-color="mist"]) .poster-slot :global(.poster[data-poster-color="mist"]) {
    display: block;
  }

  /* Mais específica que a regra de cor acima: com 3D, nenhum pôster aparece. */
  :global(html[data-stage="ready"]) .poster-slot :global(img.poster[data-poster]) {
    display: none;
  }

  /* ---- Celular ---------------------------------------------------------------------------- */
  @media (max-width: 1023.98px) {
    .scene:not(.scene--intro) .poster-slot {
      order: -1;
    }

    .poster-slot :global(.poster) {
      max-width: 18rem;
    }

    /* O texto fica sobre o aparelho: um degradê da cor do fundo garante a leitura. */
    .copy {
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-l) var(--gutter) 0;
      background: linear-gradient(to top, var(--bg) 72%, transparent);
    }
  }
</style>
