---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { colorIds, colorways, copy, defaultColor, sceneIds, type SceneId, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = copy[lang];

// Pôsteres gerados por `npm run posters`. Se ainda não existirem, as cenas ficam só com texto.
const posterFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/posters/*.png", { eager: true });
const poster = (name: string) => posterFiles[`../assets/posters/${name}.png`]?.default;
const postersFor = (id: SceneId) =>
  id === "colors"
    ? colorIds.map((color) => ({ image: poster(`colors-${color}`), color }))
    : [{ image: poster(id), color: undefined }];
---

<Base title={text.meta.title} description={text.meta.description}>
  <main>
    {
      sceneIds.map((id) => {
        const scene = text.scenes[id];
        const Heading = id === "intro" ? "h1" : "h2";
        return (
          <section class={`scene scene--${id}`} id={id} data-scene-id={id} aria-labelledby={`${id}-title`}>
            <div class="copy">
              <p class="eyebrow">{scene.eyebrow}</p>
              <Heading id={`${id}-title`}>{scene.title}</Heading>
              <p class="body">{scene.body}</p>

              {id === "inside" && (
                <ol class="layers">
                  {text.layers.map((layer) => (
                    <li>{layer}</li>
                  ))}
                </ol>
              )}

              {id === "colors" && (
                <div class="colors" role="group" aria-label={text.colorsLabel}>
                  {colorIds.map((color) => (
                    <button
                      type="button"
                      class="color"
                      data-color-option={color}
                      aria-pressed={color === defaultColor ? "true" : "false"}
                      style={`--swatch: ${colorways[color].frame}`}
                    >
                      <span class="swatch" aria-hidden="true" />
                      {text.colors[color]}
                    </button>
                  ))}
                </div>
              )}

              {id === "specs" && (
                <table class="specs">
                  <caption>{text.specs.caption}</caption>
                  <tbody>
                    {text.specs.rows.map(([label, value]) => (
                      <tr>
                        <th scope="row">{label}</th>
                        <td>{value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>

            <div class="poster-slot">
              {postersFor(id).map(
                ({ image, color }) =>
                  image && (
                    <Picture
                      src={image}
                      formats={["avif", "webp"]}
                      widths={[450, 900]}
                      sizes="(min-width: 1024px) 26rem, 70vw"
                      alt=""
                      class="poster"
                      data-poster
                      data-poster-color={color}
                      loading={id === "intro" ? "eager" : "lazy"}
                      fetchpriority={id === "intro" ? "high" : "auto"}
                    />
                  ),
              )}
            </div>
          </section>
        );
      })
    }
  </main>
</Base>

<style>
  .scene {
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: var(--space-l) var(--gutter);
  }

  .copy {
    max-width: 34rem;
  }

  /* Pôsteres: aparecem sem 3D (sem WebGL, sem JS ou com movimento reduzido) e somem quando ele monta. */
  .poster-slot {
    display: grid;
    justify-items: center;
  }

  .poster-slot :global(.poster) {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
  }

  .poster-slot :global(.poster[data-poster-color]) {
    display: none;
  }

  :global(html[data-color="graphite"]) .poster-slot :global(.poster[data-poster-color="graphite"]),
  :global(html[data-color="sand"]) .poster-slot :global(.poster[data-poster-color="sand"]),
  :global(html[data-color="mist"]) .poster-slot :global(.poster[data-poster-color="mist"]) {
    display: block;
  }

  /* Mais específica que a regra de cor acima: com 3D, nenhum pôster aparece. */
  :global(html[data-stage="ready"]) .poster-slot :global(img.poster[data-poster]) {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .poster-slot {
      order: -1;
    }

    .poster-slot :global(.poster) {
      max-width: 18rem;
    }
  }

  /* No celular o texto fica sobre o aparelho: um degradê do fundo garante a leitura. */
  @media (max-width: 1023.98px) {
    .copy {
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-l) var(--gutter) 0;
      background: linear-gradient(to top, var(--bg) 70%, transparent);
    }
  }

  @media (min-width: 1024px) {
    .scene {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .scene--intro {
    align-items: center;
  }

  .scene--intro h1 {
    font-size: var(--step-3);
    font-weight: 800;
  }

  h2 {
    font-size: var(--step-2);
    font-weight: 700;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-s);
    text-transform: uppercase;
  }

  .body {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.4;
    margin: var(--space-s) 0 0;
  }

  .layers {
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .layers {
    counter-reset: layer;
  }

  .layers li {
    counter-increment: layer;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
  }

  .layers li::before {
    content: counter(layer, decimal-leading-zero) "  ";
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .colors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-m);
  }

  .color {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem 0.4rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .color[aria-pressed="true"] {
    border-color: var(--accent);
  }

  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }

  .specs {
    width: 100%;
    margin-top: var(--space-m);
    border-collapse: collapse;
  }

  .specs caption {
    color: var(--muted);
    font-size: 0.875rem;
    text-align: left;
    padding-bottom: 0.5rem;
  }

  .specs th,
  .specs td {
    border-top: 1px solid var(--line);
    padding: 0.6rem 0;
    text-align: left;
    vertical-align: top;
  }

  .specs th {
    color: var(--muted);
    font-weight: 500;
    padding-right: var(--space-s);
  }
</style>
